import curses
import random
import string

CHARS = string.ascii_letters + string.digits + "@#$%&*+=<>?"
TRAIL = 12  # длина хвоста


def main(scr):
    curses.curs_set(0)
    scr.nodelay(True)
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(1, curses.COLOR_GREEN, -1)
    curses.init_pair(2, curses.COLOR_WHITE, -1)

    h, w = scr.getmaxyx()
    drops = [random.randint(-h, 0) for _ in range(w)]

    while scr.getch() != ord("q"):
        new_h, new_w = scr.getmaxyx()
        if (new_h, new_w) != (h, w):  # окно изменили — перезапускаем
            h, w = new_h, new_w
            drops = [random.randint(-h, 0) for _ in range(w)]
            scr.clear()

        for x in range(w - 1):
            y = drops[x]
            if 0 <= y < h:  # яркая "голова"
                scr.addstr(y, x, random.choice(CHARS),
                           curses.color_pair(2) | curses.A_BOLD)
            if 0 <= y - 1 < h:  # зелёный след
                scr.addstr(y - 1, x, random.choice(CHARS), curses.color_pair(1))
            if 0 <= y - TRAIL < h:  # стираем конец хвоста
                scr.addstr(y - TRAIL, x, " ")

            drops[x] += 1
            if drops[x] - TRAIL > h and random.random() > 0.9:
                drops[x] = 0  # запускаем новую каплю

        scr.refresh()
        curses.napms(50)


if __name__ == "__main__":
    curses.wrapper(main)